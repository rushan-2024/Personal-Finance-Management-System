# FinFlow Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── Flask ──────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_SECRET_KEY=another-long-random-secret-for-jwt

# ── Database ───────────────────────────────────────
# SQLite (local dev — no setup needed)
# DEV_DATABASE_URL=sqlite:///finflow_dev.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/finflow

# ── Email (optional — for reports/alerts) ─────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@finflow.app

# ── External APIs (optional) ───────────────────────
# Exchange rate API key (https://exchangeratesapi.io)
EXCHANGE_RATE_API=your-api-key-here

# OpenAI (optional — for GPT-powered insights)
# OPENAI_API_KEY=sk-...
